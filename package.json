{
  "name": "@timmsy/riftjs",
  "version": "4.0.0",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "browser": null,
      "import": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      },
      "require": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "docs",
    "CHANGELOG.md",
    "MAINTAINER_NOTES.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/build-entrypoints.mjs",
    "test": "npm run build && tsc -p tests/tsconfig.json && tsc -p tests/tsconfig.nodenext.json && tsc -p tests/tsconfig.bundler.json && node --test tests/*.test.cjs",
    "test:endpoints": "npm run build && node dist/test-endpoints.js",
    "prepack": "npm run build",
    "check:coverage": "node scripts/check-endpoint-coverage.mjs",
    "test:integrations": "node scripts/test-integrations.mjs"
  },
  "dependencies": {
    "axios": "^1.20.0",
    "dotenv": "^18.0.6"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "typescript": "^5.8.2"
  },
  "keywords": [
    "riot-api",
    "league-of-legends",
    "lol-api",
    "datadragon",
    "summoner",
    "match-history",
    "game-data",
    "node-js",
    "javascript",
    "typescript",
    "api-wrapper"
  ],
  "author": "James Timms",
  "description": "Server-side JavaScript and TypeScript Riot League of Legends API for Node.js, Next.js and Nuxt",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/timmsy1998/RiftJS.git"
  },
  "engines": {
    "node": ">=22"
  }
}
